# Copy to .env next to docker-compose.yml and edit. Only PHOTOS_LIBRARY is required.

# The folder with your photos (each sub-folder you pick becomes an album). Never copied or moved.
PHOTOS_LIBRARY=/path/to/your/photos
# Where the app keeps its database, thumbnails, faces and trash (back this up).
PHOTOS_DATA=./data

# Sign-in for the web app and the Immich phone app. Leave PHOTOS_PASSWORD empty to create the user on the first visit.
PHOTOS_EMAIL=admin@photos.local
PHOTOS_PASSWORD=
# Name shown in the apps; empty = the part of the email before "@", capitalised.
PHOTOS_NAME=

# Host names your reverse proxy forwards (other Host headers are refused).
PHOTOS_ALLOWED_HOSTS=localhost,127.0.0.1
# Loopback port the reverse proxy talks to.
PHOTOS_PORT=9556

# Offline machine learning (CPU): face detection and grouping (People), and smart search by words. 1 = on, 0 = off.
PHOTOS_FACES=1
PHOTOS_CLIP=1

# Folders (relative to PHOTOS_LIBRARY) picked as albums on the first start, comma separated.
PHOTOS_DEFAULT_ALBUMS=
# Time zone used for photos without one in their EXIF data.
TZ=UTC
PHOTOS_CPUS=2
PHOTOS_MEMORY=2g
# Image to run; pin a version (e.g. ghcr.io/ricardopsantos/negative:0.1.0) to upgrade only when you choose.
PHOTOS_IMAGE=ghcr.io/ricardopsantos/negative:latest
